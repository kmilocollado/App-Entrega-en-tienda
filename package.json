{
  "name": "entrega-tienda-app",
  "private": true,
  "version": "0.1.0",
  "description": "Custom app de Vidal Vidal — Entrega en tienda (delivery customization, shipping discount function, Checkout UI + configuración embebida)",
  "type": "module",
  "scripts": {
    "dev": "npx shopify app dev --config entrega-tienda",
    "build": "npx shopify app build --config entrega-tienda",
    "deploy": "npx shopify app deploy --config entrega-tienda --allow-updates",
    "deploy:fly": "fly deploy",
    "config:link": "npx shopify app config link",
    "config:use": "npx shopify app config use",
    "generate:extension": "npx shopify app generate extension",
    "setup": "npm exec prisma generate && npm exec prisma migrate deploy",
    "postinstall": "npm exec prisma generate",
    "docker-start": "npm run setup && npm run start",
    "start": "npm exec react-router-serve ./build/server/index.js",
    "typecheck": "npm run typecheck --workspaces --if-present && react-router typegen && tsc --noEmit"
  },
  "workspaces": [
    "extensions/*"
  ],
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.0",
    "isbot": "^5.1.31",
    "prisma": "^6.16.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/cli": "^3.94.3",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "engines": {
    "node": ">=20.10",
    "npm": ">=10"
  }
}
